<script lang="ts">
	// Svelte 5 Runes state
	let projectId = $state('00000000-0000-0000-0000-000000000001');
	let createdBy = $state('00000000-0000-0000-0000-000000000002');
	let identifier = $state('KIZ-101');
	let title = $state('Implement Dashboard Interface');
	let description = $state('Testing the create ticket endpoint via frontend UI');
	let priority = $state('high');

	let loading = $state(false);
	let responseStatus = $state<number | null>(null);
	let responseData = $state<any>(null);
	let errorMessage = $state<string | null>(null);

	// Session list of created tickets for easy testing inspection
	let createdTickets = $state<Array<any>>([]);

	function generateUUID(target: 'project' | 'user') {
		const newUuid = crypto.randomUUID();
		if (target === 'project') {
			projectId = newUuid;
		} else {
			createdBy = newUuid;
		}
	}

	function incrementIdentifier() {
		const match = identifier.match(/^(.*?)(\d+)$/);
		if (match) {
			const prefix = match[1];
			const num = parseInt(match[2], 10) + 1;
			identifier = `${prefix}${num}`;
		} else {
			identifier = `${identifier}-1`;
		}
	}

	async function handleSubmit(e: SubmitEvent) {
		e.preventDefault();
		loading = true;
		errorMessage = null;
		responseStatus = null;
		responseData = null;

		const payload = {
			project_id: projectId,
			identifier: identifier,
			title: title,
			description: description,
			priority: priority,
			created_by: createdBy
		};

		try {
			// Sends request directly to Traefik at /api/tickets
			const res = await fetch('/api/tickets', {
				method: 'POST',
				headers: {
					'Content-Type': 'application/json'
				},
				body: JSON.stringify(payload)
			});

			responseStatus = res.status;
			const data = await res.json();
			responseData = data;

			if (!res.ok) {
				errorMessage = data.error || data.message || `Request failed with status ${res.status}`;
			} else {
				createdTickets = [data, ...createdTickets];
				incrementIdentifier();
			}
		} catch (err: any) {
			errorMessage = err.message || 'Failed to connect to backend service';
		} finally {
			loading = false;
		}
	}
</script>

<div class="min-h-screen bg-slate-900 text-slate-100 p-6 md:p-10 font-sans">
	<header class="max-w-6xl mx-auto mb-8 border-b border-slate-800 pb-5 flex justify-between items-center">
		<div>
		<div>
			<h1 class="text-3xl font-bold tracking-tight text-indigo-400">Kizen Developer Dashboard</h1>
			<p class="text-sm text-slate-400 mt-1">Live endpoint testing for <code class="bg-slate-800 px-2 py-0.5 rounded text-indigo-300">POST /api/tickets</code></p>
		</div>
		<div class="flex items-center gap-2">
			<span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-medium bg-emerald-500/10 text-emerald-400 border border-emerald-500/20">
				<span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
				Tilt Active
			</span>
		</div>
	</header>

	<main class="max-w-6xl mx-auto grid grid-cols-1 lg:grid-cols-12 gap-8">
		<!-- Ticket Form -->
		<section class="lg:col-span-7 bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 shadow-xl">
			<h2 class="text-xl font-semibold mb-4 text-slate-200 flex items-center gap-2">
				<svg class="w-5 h-5 text-indigo-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
				Create New Ticket
			</h2>

			<form onsubmit={handleSubmit} class="space-y-4">
				<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
					<div>
						<label for="project_id" class="block text-xs font-medium text-slate-400 mb-1">Project ID (UUID)</label>
						<div class="flex gap-2">
							<input
								id="project_id"
								type="text"
								bind:value={projectId}
								required
								class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 font-mono"
							/>
							<button type="button" onclick={() => generateUUID('project')} class="px-2.5 py-1 text-xs bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition">New</button>
						</div>
					</div>

					<div>
						<label for="created_by" class="block text-xs font-medium text-slate-400 mb-1">Created By (UUID)</label>
						<div class="flex gap-2">
							<input
								id="created_by"
								type="text"
								bind:value={createdBy}
								required
								class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-xs text-slate-200 focus:outline-none focus:border-indigo-500 font-mono"
							/>
							<button type="button" onclick={() => generateUUID('user')} class="px-2.5 py-1 text-xs bg-slate-700 hover:bg-slate-600 rounded text-slate-300 transition">New</button>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 md:grid-cols-3 gap-4">
					<div>
						<label for="identifier" class="block text-xs font-medium text-slate-400 mb-1">Identifier</label>
						<input
							id="identifier"
							type="text"
							bind:value={identifier}
							required
							placeholder="e.g. KIZ-1"
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500 font-mono"
						/>
					</div>

					<div class="md:col-span-2">
						<label for="priority" class="block text-xs font-medium text-slate-400 mb-1">Priority</label>
						<select
							id="priority"
							bind:value={priority}
							class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
						>
							<option value="low">Low</option>
							<option value="medium">Medium</option>
							<option value="high">High</option>
							<option value="critical">Critical</option>
						</select>
					</div>
				</div>

				<div>
					<label for="title" class="block text-xs font-medium text-slate-400 mb-1">Title</label>
					<input
						id="title"
						type="text"
						bind:value={title}
						required
						placeholder="Ticket title..."
						class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
					/>
				</div>

				<div>
					<label for="description" class="block text-xs font-medium text-slate-400 mb-1">Description</label>
					<textarea
						id="description"
						bind:value={description}
						rows="3"
						placeholder="Add details..."
						class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-slate-200 focus:outline-none focus:border-indigo-500"
					></textarea>
				</div>

				<button
					type="submit"
					disabled={loading}
					class="w-full py-2.5 px-4 bg-indigo-600 hover:bg-indigo-500 disabled:bg-slate-700 text-white font-medium rounded-lg shadow transition flex items-center justify-center gap-2 cursor-pointer"
				>
					{#if loading}
						<svg class="animate-spin h-4 w-4 text-white" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg>
						Sending Request...
					{:else}
						Post to Ticket Service
					{/if}
				</button>
			</form>
		</section>

		<!-- API Inspector & Results -->
		<section class="lg:col-span-5 flex flex-col gap-6">
			<!-- Response Inspector -->
			<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 shadow-xl flex-1">
				<h2 class="text-xl font-semibold mb-4 text-slate-200 flex items-center justify-between">
					<span>Response Inspector</span>
					{#if responseStatus}
						<span class="px-2.5 py-0.5 rounded text-xs font-mono font-bold {responseStatus >= 200 && responseStatus < 300 ? 'bg-emerald-500/20 text-emerald-400' : 'bg-rose-500/20 text-rose-400'}">
							HTTP {responseStatus}
						</span>
					{/if}
				</h2>

				{#if errorMessage}
					<div class="p-3 bg-rose-500/10 border border-rose-500/30 rounded-lg text-rose-300 text-xs mb-4">
						<strong>Error:</strong> {errorMessage}
					</div>
				{/if}

				{#if responseData}
					<div class="bg-slate-950 rounded-lg p-4 font-mono text-xs overflow-x-auto border border-slate-800 text-emerald-300 max-h-80">
						<pre>{JSON.stringify(responseData, null, 2)}</pre>
					</div>
				{:else}
					<div class="h-40 border-2 border-dashed border-slate-700/50 rounded-lg flex items-center justify-center text-slate-500 text-sm">
						Submit form to inspect backend response
					</div>
				{/if}
			</div>

			<!-- Live Log -->
			<div class="bg-slate-800/60 border border-slate-700/60 rounded-xl p-6 shadow-xl">
				<h3 class="text-sm font-semibold text-slate-300 mb-3 flex justify-between items-center">
					<span>Created Tickets (Session)</span>
					<span class="text-xs font-normal text-slate-400">{createdTickets.length} total</span>
				</h3>

				<div class="space-y-2 max-h-48 overflow-y-auto pr-1">
					{#each createdTickets as item}
						<div class="p-2.5 bg-slate-900 border border-slate-700/50 rounded-lg text-xs flex justify-between items-center">
							<div>
								<span class="font-mono text-indigo-400 font-bold mr-2">{item.Identifier || item.identifier}</span>
								<span class="text-slate-200">{item.Title || item.title}</span>
							</div>
							<span class="px-2 py-0.5 bg-slate-800 text-slate-400 rounded text-[10px] font-mono">{item.Priority || item.priority}</span>
						</div>
					{:else}
						<p class="text-xs text-slate-500 italic text-center py-2">No tickets created in this session yet.</p>
					{/each}
				</div>
			</div>
		</section>
	</main>
</div>
